# Copy this file to .env and fill in your own values.
# Generate a salt/secret with, e.g.:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
#
# Generate a password hash with:
#   node -e "const c=require('crypto'); const salt='YOUR_SALT'; const pw='YOUR_PASSWORD'; console.log(c.createHash('sha256').update(salt+':'+pw).digest('hex'))"

VITE_APP_NAME=CampusTwin

VITE_AUTH_SALT=replace-with-random-hex
VITE_AUTH_SECRET=replace-with-random-hex

VITE_SESSION_TTL_MINUTES=480

VITE_ADMIN_EMAIL=admin@example.edu
VITE_ADMIN_PASSWORD_HASH=replace-with-sha256-hash
VITE_ADMIN_NAME=Admin User
VITE_ADMIN_ROLE=Administrator

VITE_STUDENT_EMAIL=student@example.edu
VITE_STUDENT_PASSWORD_HASH=replace-with-sha256-hash
VITE_STUDENT_NAME=Student User
VITE_STUDENT_ROLE=Student
